{
  "name": "size-up-life",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write .",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "bun typecheck && biome check && bun run build && cd .. && bun test spec scripts",
    "check:evidence": "cd .. && bun scripts/check-evidence.ts"
  },
  "dependencies": {
    "@p5-wrapper/next": "^3.0.1",
    "@types/p5": "^1.7.7",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "use-resize-observer": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.13",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
